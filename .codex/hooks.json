{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "codegraph sync",
            "timeout": 120,
            "statusMessage": "Syncing CodeGraph index..."
          }
        ]
      }
    ]
  }
}
