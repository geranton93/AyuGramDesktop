set(AYUGRAM_SANITIZER "none" CACHE STRING "Isolated Debug sanitizer profile")
set_property(CACHE AYUGRAM_SANITIZER PROPERTY STRINGS none asan-ubsan ubsan tsan lsan)
if (AYUGRAM_SANITIZER STREQUAL "none")
    return()
endif()

if (NOT AYUGRAM_SANITIZER MATCHES "^(asan-ubsan|ubsan|tsan|lsan)$")
    message(FATAL_ERROR "Unsupported sanitizer profile. See Telegram/build/quality/README.md")
endif()
if (DESKTOP_APP_ASAN)
    message(FATAL_ERROR "Do not combine AYUGRAM_SANITIZER with DESKTOP_APP_ASAN")
endif()
if (NOT APPLE)
    message(FATAL_ERROR "These profiles currently support macOS only. Native Windows uses DESKTOP_APP_ASAN; other hosts need GIR scanner runtime propagation first. See quality/README.md")
endif()
if (NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR MSVC)
    message(FATAL_ERROR "These profiles require Clang's Unix driver; use the documented native Windows lane")
endif()
if (CMAKE_CONFIGURATION_TYPES OR NOT CMAKE_BUILD_TYPE STREQUAL "Debug")
    message(FATAL_ERROR "Sanitizer profiles require a separate single-config Debug tree (Ninja)")
endif()
if (AYUGRAM_SANITIZER STREQUAL "asan-ubsan")
    set(ayugram_sanitize "address,undefined")
elseif (AYUGRAM_SANITIZER STREQUAL "ubsan")
    set(ayugram_sanitize "undefined")
elseif (AYUGRAM_SANITIZER STREQUAL "tsan")
    set(ayugram_sanitize "thread")
else()
    set(ayugram_sanitize "leak")
endif()

include(CheckCXXSourceCompiles)
include(CMakePushCheckState)
cmake_push_check_state(RESET)
set(CMAKE_REQUIRED_FLAGS "-fsanitize=${ayugram_sanitize}")
unset(AYUGRAM_SANITIZER_LINKS CACHE)
check_cxx_source_compiles("int main() { return 0; }" AYUGRAM_SANITIZER_LINKS)
cmake_pop_check_state()
if (NOT AYUGRAM_SANITIZER_LINKS)
    message(FATAL_ERROR "The selected compiler/runtime cannot link ${AYUGRAM_SANITIZER}")
endif()

add_compile_options(
    "$<$<COMPILE_LANGUAGE:C,CXX,OBJC,OBJCXX>:-fsanitize=${ayugram_sanitize}>"
    "$<$<COMPILE_LANGUAGE:C,CXX,OBJC,OBJCXX>:-fno-omit-frame-pointer>"
    "$<$<COMPILE_LANGUAGE:C,CXX,OBJC,OBJCXX>:-g>"
)
add_link_options("$<$<LINK_LANGUAGE:C,CXX,OBJC,OBJCXX>:-fsanitize=${ayugram_sanitize}>")
if (NOT AYUGRAM_SANITIZER STREQUAL "tsan" AND NOT AYUGRAM_SANITIZER STREQUAL "lsan")
    add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX,OBJC,OBJCXX>:-fno-sanitize-recover=undefined>")
    add_link_options("$<$<LINK_LANGUAGE:C,CXX,OBJC,OBJCXX>:-fno-sanitize-recover=undefined>")
endif()
message(STATUS "Sanitizer: ${AYUGRAM_SANITIZER}; prebuilt dependencies are not instrumented")
